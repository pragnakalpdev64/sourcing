# Copy to infra/secrets.env (gitignored) and fill in; setup_gcp.sh uploads each
# non-empty value as a new version of secret sourcing-<name in lowercase-with-dashes>
# (e.g. ANTHROPIC_API_KEY -> sourcing-anthropic-api-key). Delete the file afterwards.
# Vendor logins are not here: they are sourcing-vendor-<vendor> secrets (see README).
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Only the provider set as LLM_PROVIDER needs a real value; the rest can stay empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CHAT_WEBHOOK_URL=
# Leave empty to generate one
TRIGGER_SECRET=
# Login update page: the OAuth client's secret (client id goes in cloudbuild's
# _OAUTH_CLIENT_ID); SESSION_SECRET left empty is generated.
GOOGLE_OAUTH_CLIENT_SECRET=
SESSION_SECRET=
