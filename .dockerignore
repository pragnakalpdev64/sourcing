# The image holds only what runs on Cloud Run: sourcing/, service/ and
# scripts/check_access.py (Dockerfile). Everything else stays out of the build
# context: secrets, local state, run logs, vendor pages, docs, the add-on.
.venv
.git
**/__pycache__
**/*.pyc
.pytest_cache
.env
.env.*
!.env.example
infra
tests
test_runs
debug_pages*
docs
apps_script
samples
.playwright-mcp
*.log
*.md
*.docx
.local_store.json*
.local_login*.json
.local_passkey*.json
.claude
