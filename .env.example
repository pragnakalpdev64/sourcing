# Local development only. On Cloud Run these come from env vars + Secret Manager
# (see cloudbuild.yaml). Copy to .env and fill in. Never commit .env.

# --- GCP (Skylink's existing project; vendor logins are read from its Secret Manager) ---
GCP_PROJECT=skylink-material-planning
GCP_REGION=us-central1
WORKER_JOB_NAME=sourcing-worker
# firestore (Cloud Run) | file (local JSON file, kept between runs: Context reuse works)
# | memory (local, lost when the run ends)
STORE_BACKEND=file
# STORE_FILE=.local_store.json   # default: sourcing-proto/.local_store.json

# --- Sheet: a Google Sheet id (share it with your ADC user or the runtime service
# account), or a local .xlsx path for local testing (relative to sourcing-proto/) ---
SHEET_ID=
# SHEET_ID=test.xlsx
REQUESTS_TAB=Requests
RESULTS_TAB=Results

# 1 = every run is a dry run (fake vendor, no Browserbase / Secret Manager / Claude).
# Keep 0 and use `--dummy` for a single dry run.
DUMMY_MODE=0

# --- Vendor logins (GCP Secret Manager; your gcloud ADC login is used locally) ---
# Secrets: sourcing-vendor-<vendor> (shared) or sourcing-vendor-<vendor>__<email-with-dashes>
# JSON value {"vendor": "...", "url": "...", "username": "...", "password": "...", "totp_secret": "BASE32..."}
# Read a vendor's login from a different secret, e.g. the test secret:
# VENDOR_SECRET_OVERRIDES=sourcing-vendor-proponent=sourcing-vendor-test

# --- Browser ---
# browserbase (remote browser: saved Contexts, Live View for 2FA) or local
# (Chromium on this machine / in the container; no saved cookies; Live View only
# on this machine, with LOCAL_BROWSER_LIVE_VIEW=1).
# Per run: python -m service.job_main --browser local [--headed]
BROWSER_BACKEND=browserbase
# Local browser only: 0 shows the window (debugging)
# LOCAL_BROWSER_HEADLESS=1
# Local browser: a DevTools live view on 127.0.0.1 for the 2FA handoff (testing only)
# LOCAL_BROWSER_LIVE_VIEW=0

# --- Browserbase (paid plan: Contexts + keep-alive + Live View) ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Record sessions (replay in the Browserbase dashboard). Shows login pages too:
# local debugging only, keep off on Cloud Run.
# BROWSERBASE_RECORD_SESSIONS=1
# Max session length in seconds (Browserbase closes the browser at this limit,
# even mid-run). Default 3600; billing is by minutes actually used.
# BROWSERBASE_SESSION_TIMEOUT=3600

# --- LLM (pick one provider; only its key needs filling in) ---
# Required, no defaults: a real run stops if any of the three is empty.
LLM_PROVIDER=anthropic
LLM_MODEL=
# low|medium|high|xhigh (required for anthropic; ignored by openai/gemini)
LLM_EFFORT=
ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai, LLM_MODEL=<an OpenAI model>
OPENAI_API_KEY=
# LLM_PROVIDER=gemini, LLM_MODEL=<a Gemini model>
GEMINI_API_KEY=

# --- Notifications / service ---
CHAT_WEBHOOK_URL=
TRIGGER_SECRET=
# 2FA code handoff: where the API runs. Set = a login code the worker can't make
# (email / SMS) is asked from the requester over Chat, with a link to a form.
# Locally: run the API (uvicorn service.api:app --port 8080) and use
# PUBLIC_BASE_URL=http://localhost:8080
# PUBLIC_BASE_URL=
# HITL_CODE_WAIT_SECONDS=600
# Chat app (set up by the client) for the code form inside Chat; optional.
# CHAT_APP_SPACE=spaces/AAAA...
# CHAT_APP_AUDIENCE=<the app's GCP project number>

# --- Vendor login update page (/credentials, docs/CREDENTIAL_UPDATE_UI_PLAN.md) ---
# Google sign-in: an OAuth client ("Web application") in the client's project,
# redirect URI <PUBLIC_BASE_URL>/auth/callback (locally http://localhost:8080/auth/callback).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Signs the session cookie: any long random string (openssl rand -hex 32).
# SESSION_SECRET=
# Who may sign in, and who may change every login (comma or ; separated).
# Only Google Workspace accounts of these domains; * = any verified Google
# account (Gmail too), local testing only (refused on Cloud Run).
# ALLOWED_EMAIL_DOMAINS=skylink.com
# CREDENTIAL_ADMINS=
# Local testing without an OAuth client (refused on Cloud Run):
# DEV_SIGNIN_EMAIL=you@skylink.com

# --- Tuning ---
# MAX_LOGIN_ATTEMPTS=2
# ACCOUNT_LEASE_SECONDS=1800
# JOB_LOCK_SECONDS=3600
# MAX_PAGE_CHARS=60000
