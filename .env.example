# Local development only. On Cloud Run these come from env vars + Secret Manager
# (see infra/deploy_test_revision.sh). Copy to .env and fill in. Never commit .env.

# --- GCP (Skylink's existing project; vendor logins are read from its Secret Manager) ---
GCP_PROJECT=skylink-material-planning
GCP_REGION=us-central1
WORKER_JOB_NAME=sourcing-worker
# firestore (Cloud Run) | file (local JSON file, kept between runs: Context reuse works)
# | memory (local, lost when the run ends)
STORE_BACKEND=file
# Firestore in another project than GCP_PROJECT (e.g. the add-on listing project while testing); empty = GCP_PROJECT
STORE_PROJECT=
# direct = the worker opens the sheet (Sheets API); relay = the add-on sends a copy and writes the results (Cloud Run: relay)
SHEET_ACCESS=direct
# STORE_FILE=.local_store.json   # default: .local_store.json in this folder

# --- Sheet: a Google Sheet id (share it with your ADC user or the runtime service
# account), or a local .xlsx path for local testing (relative to this folder; refused on Cloud Run) ---
SHEET_ID=
# SHEET_ID=test.xlsx
REQUESTS_TAB=Requests
RESULTS_TAB=Results

# 1 = every run is a dry run (fake vendor, no Browserbase / Secret Manager / Claude).
# Keep 0 and use `--dummy` for a single dry run.
DUMMY_MODE=0

# --- Vendor logins (GCP Secret Manager; your gcloud ADC login is used locally) ---
# Secrets: sourcing-vendor-<vendor> (shared) or sourcing-vendor-<vendor>__<email-with-dashes>
# JSON value {"vendor": "...", "url": "...", "username": "...", "password": "...", "totp_secret": "BASE32..."}
# Read a vendor's login from a different secret, e.g. the test secret:
# VENDOR_SECRET_OVERRIDES=sourcing-vendor-proponent=sourcing-vendor-test

# --- Infra keys from Secret Manager (local) ---
# gsm = ANTHROPIC_API_KEY, BROWSERBASE_API_KEY, BROWSERBASE_PROJECT_ID, CHAT_WEBHOOK_URL are
# read from sourcing-* secrets in GCP_PROJECT at start (same as the service), not from here.
# A secret that can't be read stops the start. Ignored on Cloud Run.
INFRA_SECRETS=

# --- Browser ---
# browserbase (remote browser: saved Contexts, Live View for 2FA) or local
# (Chromium on this machine / in the container; no saved cookies; Live View only
# on this machine, with LOCAL_BROWSER_LIVE_VIEW=1).
# Per run: python -m service.job_main --browser local [--headed]
BROWSER_BACKEND=browserbase
# Browserbase solves CAPTCHAs (client allowed it, 2026-11-19); the program waits up
# to 60s for it, then asks a person through Live View. 0 = always a person.
# CAPTCHA_SOLVING=1
# Local browser only: 0 shows the window (debugging)
# LOCAL_BROWSER_HEADLESS=1
# Local browser: a DevTools live view on 127.0.0.1 for the 2FA handoff (testing only)
# LOCAL_BROWSER_LIVE_VIEW=0

# --- Browserbase (paid plan: Contexts + keep-alive + Live View) ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Record sessions (replay in the Browserbase dashboard). Shows login pages too:
# local debugging only, keep off on Cloud Run.
# BROWSERBASE_RECORD_SESSIONS=1
# Max session length in seconds (Browserbase closes the browser at this limit,
# even mid-run). Default 3600; billing is by minutes actually used.
# BROWSERBASE_SESSION_TIMEOUT=3600

# --- LLM ---
# Required, no defaults: a real run stops if any of the three is empty.
LLM_PROVIDER=anthropic
LLM_MODEL=
# low|medium|high|xhigh
LLM_EFFORT=
ANTHROPIC_API_KEY=

# --- Notifications / service ---
CHAT_WEBHOOK_URL=
TRIGGER_SECRET=
# Local testing of the sheet's Apps Script through ngrok only (apps_script/README.md): /trigger
# starts the worker on this machine with these extra flags. Never set on Cloud Run.
TRIGGER_RUN_LOCAL=
TRIGGER_LOCAL_ARGS=
# Sheets add-on (apps_script/addon): its OAuth client id (listing project >
# Credentials, "Apps Script"); its calls carry the user's Google token instead of
# TRIGGER_SECRET. Uses ALLOWED_EMAIL_DOMAINS below. Not a secret.
ADDON_OAUTH_CLIENT_IDS=
# ... or any client of the add-on's listing project, by its project number (Apps
# Script makes a new client now and then, e.g. after a scope change). Not a secret.
ADDON_OAUTH_PROJECT_NUMBERS=
# Rows are read once a sheet has had no edit for this long (default 90).
TRIGGER_QUIET_SECONDS=
# Google sign-in (IAP) in front of the service (sourcing-ai-dev): the audience of IAP's
# signed header, /projects/<number>/locations/<region>/services/<service>. Empty locally.
IAP_AUDIENCE=
# 2FA code handoff: where the API runs. Set = a login code the worker can't make
# (email / SMS) is asked from the requester over Chat, with a link to a form.
# Locally: run the API (uvicorn service.api:app --port 8080) and use
# PUBLIC_BASE_URL=http://localhost:8080
# PUBLIC_BASE_URL=
# HITL_CODE_WAIT_SECONDS=600
# Chat app (set up by the client) for the code form inside Chat; optional.
# CHAT_APP_SPACE=spaces/AAAA...
# CHAT_APP_AUDIENCE=<the app's GCP project number>

# --- Add-on callers ---
# Google Workspace domains whose add-on calls are accepted (comma or ; separated);
# * = any verified Google account, local testing only (refused on Cloud Run).
# ALLOWED_EMAIL_DOMAINS=skylinkintl.com
# 1 = the add-on's caller must be able to open the sheet it names (asked from Google with
# their own token, service/sheet_access.py). Needs the Sheets API on in the add-on's Google
# Cloud project (sourcing-skylink-addon). Off by default.
# SHEET_ACCESS_CHECK=1

# --- Tuning ---
# MAX_LOGIN_ATTEMPTS=2
# ACCOUNT_LEASE_SECONDS=1800
# JOB_LOCK_SECONDS=3600
# MAX_PAGE_CHARS=60000
